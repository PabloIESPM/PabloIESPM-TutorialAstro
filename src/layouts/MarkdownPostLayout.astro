---
import BaseLayout from "./BaseLayout.astro";
const { frontmatter } = Astro.props;
---

<BaseLayout pageTitle={frontmatter.title}>
  <p><em>{frontmatter.description}</em></p>
  <p>{frontmatter.pubDate.toString().slice(0, 10)}</p>

  <p>Escrito por: {frontmatter.author}</p>

  <img
    src={frontmatter.image.url}
    alt={frontmatter.image.alt}
    class="max-w-xs sm:max-w-sm md:max-w-md mx-auto my-4 rounded shadow-md"
  />

  <div class="flex flex-wrap my-4">
    {
      frontmatter.tags.map((tag) => (
        <p class="m-1 border border-dotted border-gray-400 rounded-md py-1 px-3 text-sm bg-slate-100 hover:bg-slate-200 dark:bg-slate-700 dark:hover:bg-slate-600 dark:border-gray-600">
          <a href={`/tags/${tag}`} class="text-blue-600 dark:text-blue-400 hover:underline">{tag}</a>
        </p>
      ))
    }
  </div>

  <div class="prose prose-slate dark:prose-invert max-w-none">
    <slot />
  </div>
</BaseLayout>

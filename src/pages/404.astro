---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Error 404 - Página No Encontrada">
  <div class="text-center py-10 px-4">
    <h1 class="text-4xl font-bold text-red-600 dark:text-red-400 mb-4">Página No Encontrada</h1>
    <p class="text-lg text-slate-700 dark:text-slate-300 mb-8">
      Lo sentimos, la página que buscas no existe o ha sido movida.
    </p>
    <a
      href="/"
      class="inline-block bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-lg shadow-md transition duration-300 ease-in-out"
    >
      Volver al inicio
    </a>
  </div>
</BaseLayout>
